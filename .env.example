# ── Farm Platform Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── TimescaleDB (PostgreSQL) ──────────────────────────────────────────────────
POSTGRES_USER=farm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=farm_platform
# DSN used by the backend; references the Docker service name
POSTGRES_DSN=postgresql://farm:changeme@timescaledb:5432/farm_platform

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_USER=farm
MONGO_PASSWORD=changeme
MONGO_URI=mongodb://farm:changeme@mongodb:27017/farm_platform?authSource=admin

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=changeme

# ── Anthropic (Claude API) ────────────────────────────────────────────────────
# https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Ambient Weather ───────────────────────────────────────────────────────────
# https://ambientweather.net/account  -- Two separate keys required
AMBIENT_API_KEY=
AMBIENT_APP_KEY=

# ── Alpaca Markets ────────────────────────────────────────────────────────────
# Paper trading (free, no approval needed)
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
# Live trading (requires Alpaca account approval)
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# ── NewsAPI ───────────────────────────────────────────────────────────────────
# https://newsapi.org  -- Free tier: 100 req/day
NEWSAPI_KEY=

# ── Finnhub ───────────────────────────────────────────────────────────────────
# https://finnhub.io  -- Free tier covers IPO calendar + headlines
FINNHUB_KEY=

# ── Quiver Quantitative ───────────────────────────────────────────────────────
# https://quiverquant.com  -- Free tier covers congressional trades
QUIVER_API_KEY=

# ── Operator / Farm Config ────────────────────────────────────────────────────
# Planting date for GDU accumulation (ISO format)
PLANTING_DATE_CORN=2025-05-01
PLANTING_DATE_BEANS=2025-05-10
# Expected bushels for contract sizing
EXPECTED_BUSHELS_CORN=45000
EXPECTED_BUSHELS_BEANS=18000

# ── Scheduling ────────────────────────────────────────────────────────────────
# Futures feed pull interval during market hours (minutes)
FUTURES_FEED_INTERVAL_MIN=15
# Open-Meteo regional weather pull interval (hours)
WEATHER_FEED_INTERVAL_HRS=6
