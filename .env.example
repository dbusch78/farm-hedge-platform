# ── Farm Platform Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── TimescaleDB (PostgreSQL) ──────────────────────────────────────────────────
# IMPORTANT: avoid $ followed by digits in passwords (e.g. $1, $2) —
# some config parsers treat $N as a variable reference and strip it.
POSTGRES_USER=farm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=farm_platform
# DSN used by the backend; references the Docker service name
POSTGRES_DSN=postgresql://farm:changeme@timescaledb:5432/farm_platform

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_USER=farm
MONGO_PASSWORD=changeme
MONGO_URI=mongodb://farm:changeme@mongodb:27017/farm_platform?authSource=admin

# ── Anthropic (Claude API) ────────────────────────────────────────────────────
# https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Ambient Weather ───────────────────────────────────────────────────────────
# https://ambientweather.net/account  -- Two separate keys required
AMBIENT_API_KEY=
AMBIENT_APP_KEY=
# MAC address of the outdoor farm station (find in Ambient Dashboard → Device Info)
# Indoor sensors on the same hub (freezer, fridge, etc.) are ignored automatically.
AMBIENT_STATION_MAC=
# How often to poll (minutes) -- Ambient free tier allows 1 req/sec
AMBIENT_POLL_INTERVAL_MIN=5

# ── Alpaca Markets ────────────────────────────────────────────────────────────
# Paper trading (free, no approval needed)
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
# Live trading (requires Alpaca account approval)
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# ── NewsAPI ───────────────────────────────────────────────────────────────────
# https://newsapi.org  -- Free tier: 100 req/day
NEWSAPI_KEY=

# ── Finnhub ───────────────────────────────────────────────────────────────────
# https://finnhub.io  -- Free tier covers IPO calendar + headlines
FINNHUB_KEY=

# ── Quiver Quantitative ───────────────────────────────────────────────────────
# https://quiverquant.com  -- Free tier covers congressional trades
QUIVER_API_KEY=

# ── Operator / Farm Config ────────────────────────────────────────────────────
# Planting date for GDU accumulation (ISO format)
PLANTING_DATE_CORN=2025-05-01
PLANTING_DATE_BEANS=2025-05-10
# Expected bushels for contract sizing
EXPECTED_BUSHELS_CORN=45000
EXPECTED_BUSHELS_BEANS=18000

# ── Elevator Scraper (River Valley Co-op) ────────────────────────────────────
# Your RVC account credentials (used for headless Selenium login)
ELEVATOR_RVC_EMAIL=
ELEVATOR_RVC_PASSWORD=
# Base URL for RVC (default is correct for River Valley Co-op)
ELEVATOR_RVC_BASE=https://shop.rivervalleycoop.com
# Full URL for the cash bids JSON API endpoint
ELEVATOR_CASH_BIDS_URL=
# Full URL for the futures quotes JSON API endpoint (optional but recommended)
# Provides RVC's own futures reference prices as a cross-check against yfinance
ELEVATOR_FUTURES_URL=https://shop.rivervalleycoop.com/api/v1/commodity/futures
# Comma-separated elevator/location names exactly as they appear in the API
# Example: ELEVATOR_NAMES=Toulon,Kewanee
ELEVATOR_NAMES=
# Path to persist auth cookies between scrapes (relative to project root)
ELEVATOR_COOKIE_PATH=.cache/elevator_cookies.pkl
# How often to scrape (hours)
ELEVATOR_SCRAPER_INTERVAL_HRS=1

# ── Scheduling ────────────────────────────────────────────────────────────────
# Futures feed pull interval during market hours (minutes)
FUTURES_FEED_INTERVAL_MIN=15
# Open-Meteo regional weather pull interval (hours)
WEATHER_FEED_INTERVAL_HRS=6
# Alert worker check interval (minutes)
ALERT_CHECK_INTERVAL_MIN=15

# ── Alerting (Milestone 4.5) ─────────────────────────────────────────────────
# Email -- use Gmail app password or Mailgun free tier
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_PASSWORD=
# Telegram -- create a bot via @BotFather, then message your bot to get CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Alert thresholds
ALERT_BASIS_CORN_MIN=-0.45
ALERT_BASIS_BEANS_MIN=-0.60
ALERT_NEP_CORN_TARGET=4.50
ALERT_NEP_BEANS_TARGET=11.00
ALERT_STALE_MINUTES=30
# How long before the same alert can re-fire (hours)
ALERT_COOLDOWN_HRS=4
